<?xml version="1.0" encoding="utf-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/aes">
        <comment>AES Crypt document</comment>
        <acronym>AES Crypt</acronym>
        <generic-icon name="aescrypt_paper"/>
        <glob pattern="*.aes"/>
        <alias type="application/aes"/>
        <alias type="application/aescrypt"/>
        <alias type="application/x-aes"/>
        <magic priority="50">
            <match type="string" offset="0" value="AES">
                <match type="byte" offset="3" value="0">
                    <match type="byte" offset="4" mask="0xf0" value="0"/>
                </match>
            </match>
            <match type="string" offset="0" value="AES">
                <match type="byte" offset="4" value="0">
                    <match type="byte" offset="3" mask="0x01" value="0x01"/>
                    <match type="byte" offset="3" mask="0x02" value="0x02"/>
                    <match type="byte" offset="3" mask="0x04" value="0x04"/>
                    <match type="byte" offset="3" mask="0x08" value="0x08"/>
                    <match type="byte" offset="3" mask="0x10" value="0x10"/>
                    <match type="byte" offset="3" mask="0x20" value="0x20"/>
                    <match type="byte" offset="3" mask="0x40" value="0x40"/>
                    <match type="byte" offset="3" mask="0x80" value="0x80"/>
                </match>
            </match>
        </magic>
    </mime-type>
</mime-info>
